{
  "name": "@tekindar666/styles",
  "version": "0.1.0",
  "description": "Minimal React components with themeable Zen styling.",
  "type": "module",
  "files": ["dist", "zen/*.css"],
  "sideEffects": ["**/*.css"],
  "exports": {
    "./zen": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./zen/styles.css": "./zen/styles.css",
    "./zen/tailwind.css": "./zen/tailwind.css"
  },
  "scripts": {
    "build": "tsc",
    "build:preview": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.preview.json",
    "preview": "vite --host 127.0.0.1 --port 4173",
    "test": "npm run build && node --test tests/*.test.js",
    "lint": "oxlint --deny-warnings src preview tests",
    "prepack": "npm run build"
  },
  "peerDependencies": { "react": "^19.0.0", "react-dom": "^19.0.0" },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "playwright": "^1.56.0",
    "oxlint": "^1.0.0"
  }
}
